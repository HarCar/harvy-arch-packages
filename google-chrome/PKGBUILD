pkgname=google-chrome
pkgver=153.0.8010.36
pkgrel=1
pkgdesc="The popular web browser by Google (Stable Channel)"
arch=('x86_64')
url="https://www.google.com/chrome"
license=('custom:chrome')
depends=('alsa-lib' 'gtk3' 'libcups' 'libxss' 'libxtst' 'nss'
         'ttf-liberation' 'xdg-utils')
optdepends=('pipewire: WebRTC desktop sharing under Wayland'
            'kdialog: file dialogs in KDE'
            'gnome-keyring: password storage in GNOME keyring'
            'kwallet: password storage in KWallet')
options=('!emptydirs' '!strip')
_channel=stable
source=('eula_text.html' "google-chrome-$_channel.sh")
sha512sums=('a225555c06b7c32f9f2657004558e3f996c981481dbb0d3cd79b1d59fa3f05d591af88399422d3ab29d9446c103e98d567aeafe061d9550817ab6e7eb0498396'
            '1eff15f26c3fff6e00c9c73b342532b23d5f2840f3d3a199530442621b4c8a3702c63b8a731026d08d7083ad8b95713544c337bddc089f6ec8cd0e218960dd86')
sha512sums_x86_64=('a021007d23ff41cf51e4805b339b6923581e349a6fc9ea32dcea7182622b961a38ce102564904ee0de25113f005b538fcf5f22b8a6ed28e1d596370c5a3bc35a')
source_x86_64=("https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-${_channel}/google-chrome-${_channel}_${pkgver}-1_amd64.deb")

package() {
    bsdtar -xf data.tar.xz -C "$pkgdir/"
    install -m755 "google-chrome-$_channel.sh" "$pkgdir/usr/bin/google-chrome-$_channel"

    for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256; do
        install -Dm644 "$pkgdir/opt/google/chrome/product_logo_${size/x*/}.png" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/google-chrome.png"
    done

    install -Dm644 eula_text.html \
        "$pkgdir/usr/share/licenses/google-chrome/eula_text.html"
    install -Dm644 "$pkgdir/opt/google/chrome/WidevineCdm/LICENSE" \
        "$pkgdir/usr/share/licenses/google-chrome/WidevineCdm-LICENSE.txt"

    sed -i \
        -e '/Exec=/i\StartupWMClass=Google-chrome' \
        -e 's/x-scheme-handler\/ftp;\?//g' \
        "$pkgdir/usr/share/applications/google-chrome.desktop"

    rm -r "$pkgdir/etc/cron.daily" \
          "$pkgdir/opt/google/chrome/cron" \
          "$pkgdir"/opt/google/chrome/product_logo_*.png
}
